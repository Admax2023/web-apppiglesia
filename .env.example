# Base URL of the API as seen by the browser. Default "/api" (same origin; Vite dev proxy in development).
# Example when the API lives on another domain: VITE_API_BASE_URL=https://api.mi-iglesia.org/api
VITE_API_BASE_URL=/api
# Only for `npm run dev` / `npm run preview`: where the /api proxy forwards to.
VITE_DEV_PROXY_TARGET=http://localhost:8000
